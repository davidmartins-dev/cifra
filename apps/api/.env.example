NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN="http://localhost:3001"

# Conexão com o Postgres (Docker local)
DATABASE_URL="postgresql://cifra_user:cifra_password@localhost:5432/cifra_db?schema=public"

# Autenticação (tempo de expiração do JWT alinhado com a duração da sessão/cookie HttpOnly)
JWT_SECRET=sua_chave_secreta_jwt_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=5m

# Envio de E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app_do_google
EMAIL_FROM="Cifra <seu_email@gmail.com>"
